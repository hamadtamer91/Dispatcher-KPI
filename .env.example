# Copy this file to .env.local and fill in real values.
# Get these from the Supabase project dashboard: Settings -> API
# Project: nexafix-dispatcher-kpi (aejtnodojscvolcejrdx)

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Not used by the frontend, listed here for reference only ---
# The following are NOT read from this file. They are Supabase Edge Function
# secrets (set via `supabase secrets set` or the Supabase dashboard, never in
# a .env file in this repo) and Vercel project env vars:
#
#   Edge Function secrets (sync-excel-kpi):
#     MS_TENANT_ID, MS_CLIENT_ID, MS_CLIENT_SECRET, MS_SHARE_URL, MS_TABLE_NAME
#   Edge Function secrets (generate-proposal):
#     GEMINI_API_KEY (or equivalent), GEMINI_MODEL (optional override)
#   Supabase service role key (used server-side only, inside Edge Functions):
#     SUPABASE_SERVICE_ROLE_KEY
